"format": "hls-2142-1 - 1280x720"}, {"format_id": "hls-4347", "url": "https://hugh.cdn.rumble.cloud/video/fww1/db/s8/2/C/W/l/9/CWl9A.Eaa.rec.tar?r_file=chunklist.m3u8&r_type=application%2Fvnd.apple.mpegurl&r_range=1744487424-1744521355", "manifest_url": "https://rumble.com/hls-vod/FaBPDtWxQwo/playlist-721.m3u8", "tbr": 4347.0, "ext": "mp4", "protocol": "m3u8_native", "has_drm": false, "width": 1280, "height": 720, "video_ext": "mp4", "audio_ext": "none", "resolution": "1280x720", "dynamic_range": "SDR", "aspect_ratio": 1.78, "http_headers": {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/148.0.0.0 Safari/537.36", "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8", "Accept-Language": "en-us,en;q=0.5", "Sec-Fetch-Mode": "navigate"}, "format": "hls-4347 - 1280x720"}], "subtitles": {"en-auto": [{"url": "https://hugh.cdn.rumble.cloud/video/fww1/db/s8/11/C/W/l/9/CWl9A.fn8Si.vtt", "name": "English (auto)", "ext": "vtt"}]}, "thumbnails": [{"url": "https://hugh.cdn.rumble.cloud/video/fww1/db/s8/1/C/W/l/9/CWl9A.aiEB-small-VSRF-Live-251-The-Business-..jpg", "width": 720, "height": 1280, "id": "0", "resolution": "720x1280"}, {"url": "https://hugh.cdn.rumble.cloud/video/fww1/db/s8/1/C/W/l/9/CWl9A.qR4e-small-VSRF-Live-251-The-Business-..jpg", "width": 1280, "height": 720, "id": "1", "resolution": "1280x720"}], "timestamp": 1792712402, "channel": "Vaccine Safety Research Foundation", "channel_url": "https://rumble.com/c/VaccineSafetyResearchFoundation", "duration": 3210, "uploader": "Vaccine Safety Research Foundation", "live_status": "was_live", "webpage_url": "https://rumble.com/v7h97oc-vsrf-live-251-the-business-of-keeping-us-sick.html", "webpage_url_basename": "v7h97oc-vsrf-live-251-the-business-of-keeping-us-sick.html", "webpage_url_domain": "rumble.com", "extractor": "RumbleEmbed", "extractor_key": "RumbleEmbed", "release_timestamp": 1793142004, "view_count": 8101, "like_count": 138, "dislike_count": 1, "description": "What happens when the industries entrusted with improving our health have a financial interest in keeping us sick?Show more This Tuesday on VSRF Live, British cardiologist Dr. Aseem Malhotra joins Steve Kirsch for a revealing conversation about corporate influence over modern medicine, the pharmaceutical and food industries, and a healthcare system he believes has lost sight of its most fundamental purpose: keeping people healthy.\nLong before COVID, Malhotra was challenging conventional medical thinking, questioning the widespread prescribing of statins, raising concerns about pharmaceutical industry influence on clinical guidelines, and advocating for dietary changes to address heart disease, obesity, and type 2 diabetes. He has become a leading voice for metabolic health, arguing that many chronic conditions can be prevented, improved, or even reversed through changes in nutrition and lifestyle.\nInitially a public advocate for COVID-19 vaccination, Malhotra later became one of its most outspoken critics after questioning the safety of the shots and the integrity of the evidence supporting them. His public reversal brought him into direct conflict with the medical establishment and intensified his broader campaign against what he calls the corporate capture of healthcare.\nNow practicing in Florida, Malhotra is calling for a fundamental shift away from a system focused on managing illness with medications and toward one that prioritizes prevention, metabolic health, transparency, and genuine patient well-being.\nThis Tuesday, he'll join Steve Kirsch to examine how Big Pharma and Big Food influence medical research, treatment guidelines, and public health policy—and why he believes financial incentives have helped fuel an epidemic of chronic disease.\nHas modern medicine become better at managing sickness than restoring health? And what will it take to reclaim a healthcare system that puts patients—not corporate profits—first?\nJoin us for a conversation about medical corruption, informed consent, and the path toward a healthier future. Show less", "thumbnail": "https://hugh.cdn.rumble.cloud/video/fww1/db/s8/1/C/W/l/9/CWl9A.qR4e-small-VSRF-Live-251-The-Business-..jpg", "display_id": "v7f2uqu", "fulltitle": "VSRF Live #251 - The Business Of Keeping Us Sick", "duration_string": "53:30", "upload_date": "20261022", "release_date": "20261027", "release_year": 2026, "is_live": false, "was_live": true, "epoch": 1794327057, "acodec": "aac", "vcodec": "none", "url": "https://hugh.cdn.rumble.cloud/video/fww1/db/s8/2/C/W/l/9/CWl9A.Gaa.rec.aac", "format_id": "audio-192p", "tbr": 191, "filesize": 77042695, "width": 0, "height": 192, "protocol": "https", "ext": "aac", "audio_ext": "aac", "video_ext": "none", "vbr": 0, "abr": 191, "resolution": "audio only", "aspect_ratio": 0.0, "http_headers": {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/148.0.0.0 Safari/537.36", "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8", "Accept-Language": "en-us,en;q=0.5", "Sec-Fetch-Mode": "navigate"}, "format": "audio-192p - audio only", "_type": "video", "_version": {"version": "2026.11.04.232659", "release_git_head": "412e7f0a4b0588fe884a02b344ac66a06538475b", "repository": "yt-dlp/yt-dlp-nightly-builds"}}