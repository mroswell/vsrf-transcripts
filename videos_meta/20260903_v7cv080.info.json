ode": "navigate"}, "format": "hls-2144-1 - 1280x720"}, {"format_id": "hls-4044", "url": "https://hugh.cdn.rumble.cloud/video/fwe2/db/s8/2/w/p/-/U/wp-UA.Eaa.rec.tar?r_file=chunklist.m3u8&r_type=application%2Fvnd.apple.mpegurl&r_range=2605559808-2605614582", "manifest_url": "https://rumble.com/hls-vod/hMxrIracN74/playlist-721.m3u8", "tbr": 4044.0, "ext": "mp4", "protocol": "m3u8_native", "has_drm": false, "width": 1280, "height": 720, "video_ext": "mp4", "audio_ext": "none", "resolution": "1280x720", "dynamic_range": "SDR", "aspect_ratio": 1.78, "http_headers": {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/148.0.0.0 Safari/537.36", "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8", "Accept-Language": "en-us,en;q=0.5", "Sec-Fetch-Mode": "navigate"}, "format": "hls-4044 - 1280x720"}], "subtitles": {"en-auto": [{"url": "https://hugh.cdn.rumble.cloud/video/fwe2/db/s8/11/w/p/-/U/wp-UA.fn8Si.vtt", "name": "English (auto)", "ext": "vtt"}]}, "thumbnails": [{"url": "https://hugh.cdn.rumble.cloud/video/fwe2/db/s8/1/w/p/-/U/wp-UA.aiEB.1-small-VSRF-Live-244-Turning-The-T..jpg", "width": 720, "height": 1280, "id": "0", "resolution": "720x1280"}, {"url": "https://hugh.cdn.rumble.cloud/video/fwe2/db/s8/1/w/p/-/U/wp-UA.qR4e.1-small-VSRF-Live-244-Turning-The-T..jpg", "width": 1280, "height": 720, "id": "1", "resolution": "1280x720"}], "timestamp": 1788458304, "channel": "Vaccine Safety Research Foundation", "channel_url": "https://rumble.com/c/VaccineSafetyResearchFoundation", "duration": 5154, "uploader": "Vaccine Safety Research Foundation", "live_status": "was_live", "webpage_url": "https://rumble.com/v7f1d5i-vsrf-live-244-turning-the-tables-on-medical-tyranny.html", "webpage_url_basename": "v7f1d5i-vsrf-live-244-turning-the-tables-on-medical-tyranny.html", "webpage_url_domain": "rumble.com", "extractor": "RumbleEmbed", "extractor_key": "RumbleEmbed", "release_timestamp": 1788908405, "view_count": 11252, "like_count": 156, "dislike_count": 3, "description": "What happens when a medical board puts a doctor’s judgment, speech—and even her mental fitness—on trial, only to find its own conduct facing scrutiny in federal court?Show more Next Tuesday, VSRF Live welcomes Dr. Meryl Nass, a physician and longtime medical-freedom advocate whose battle with the Maine Board of Licensure in Medicine has taken a significant turn.\nIn January 2022, the Board suspended Dr. Nass’s medical license and ordered her to undergo a neuropsychological evaluation amid controversy over her COVID-era prescribing and public statements challenging vaccines, mandates, masking, and official treatment policies.\nNass claims the Board’s psychological-evaluation order was retaliation for her constitutionally protected speech and is seeking compensatory and punitive damages from individual Board members. In 2025, a Maine court vacated the order as “arbitrary and capricious.”\nNow, more than four years later, that part of her federal civil-rights lawsuit against the individual Board members has been allowed to move forward.\nOn August 20, Chief U.S. District Judge Lance Walker ruled that the Board members are not entitled to absolute quasi-judicial immunity from Nass’s claim arising from the psychological-evaluation order. Addressing the allegations, Walker described the order as “based on no evidence or process” and said such an action “simply ought not occur, ever.” He also wrote that “political influence would appear to have been the point” and raised the possibility that the Board was “making an example out of Dr. Nass.”\nThe ruling means Dr. Nass can continue pursuing a central part of her civil-rights case and her effort to hold individual Board members personally accountable for what she alleges was retaliation for protected speech.\nNext Tuesday, Dr. Nass joins Steve to discuss what happened, what the judge’s ruling means, and what comes next in a case that raises important questions about medical dissent, due process, free speech, and the accountability of those entrusted with the power to discipline physicians.\nJoin us next Tuesday at 7 PM ET / 4 PM PT for Dr. Meryl Nass on VSRF Live.Join us for this timely and important conversation with Dr. Meryl Nass. Show less", "thumbnail": "https://hugh.cdn.rumble.cloud/video/fwe2/db/s8/1/w/p/-/U/wp-UA.qR4e.1-small-VSRF-Live-244-Turning-The-T..jpg", "display_id": "v7cv080", "fulltitle": "VSRF Live #244 - A Special Conversation with Dr. Robert Malone", "duration_string": "1:25:54", "upload_date": "20260903", "release_date": "20260908", "release_year": 2026, "is_live": false, "was_live": true, "epoch": 1794325225, "acodec": "aac", "vcodec": "none", "url": "https://hugh.cdn.rumble.cloud/video/fwe2/db/s8/2/w/p/-/U/wp-UA.Gaa.rec.aac", "format_id": "audio-192p", "tbr": 191, "filesize": 123695300, "width": 0, "height": 192, "protocol": "https", "ext": "aac", "audio_ext": "aac", "video_ext": "none", "vbr": 0, "abr": 191, "resolution": "audio only", "aspect_ratio": 0.0, "http_headers": {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/148.0.0.0 Safari/537.36", "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8", "Accept-Language": "en-us,en;q=0.5", "Sec-Fetch-Mode": "navigate"}, "format": "audio-192p - audio only", "_type": "video", "_version": {"version": "2026.11.04.232659", "release_git_head": "412e7f0a4b0588fe884a02b344ac66a06538475b", "repository": "yt-dlp/yt-dlp-nightly-builds"}}