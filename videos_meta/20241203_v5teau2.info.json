 friends and get ready to have a blast with us at The Misinformation Squares! Show less", "thumbnail": "https://1a-1791.com/video/fw/s8/1/l/o/e/m/loemv.qR4e-small-VSRF-Live-155-The-Misinform.jpg", "display_id": "v5teau2", "fulltitle": "VSRF Live #155: The Misinformation Squares!", "duration_string": "2:36:40", "upload_date": "20241203", "release_date": "20241206", "release_year": 2024, "is_live": false, "was_live": true, "epoch": 1777720401, "url": "https://1a-1791.com/video/fw/s8/2/l/o/e/m/loemv.aaa.rec.mp4", "format_id": "mp4-720p-1", "fps": 60, "tbr": 4277, "filesize": 5026637148, "width": 1280, "height": 720, "protocol": "https", "ext": "mp4", "video_ext": "mp4", "audio_ext": "none", "resolution": "1280x720", "dynamic_range": "SDR", "aspect_ratio": 1.78, "http_headers": {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/140.0.0.0 Safari/537.36", "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8", "Accept-Language": "en-us,en;q=0.5", "Sec-Fetch-Mode": "navigate"}, "format": "mp4-720p-1 - 1280x720", "_type": "video", "_version": {"version": "2026.01.31", "release_git_head": "9a9a6b6fe44a30458c1754ef064f354f04a84004", "repository": "yt-dlp/yt-dlp"}}