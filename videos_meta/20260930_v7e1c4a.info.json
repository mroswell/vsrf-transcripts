avigate"}, "format": "hls-2145-1 - 1280x720"}, {"format_id": "hls-4175", "url": "https://hugh.cdn.rumble.cloud/video/fwe2/bc/s8/2/q/A/G/2/qAG2A.Eaa.rec.tar?r_file=chunklist.m3u8&r_type=application%2Fvnd.apple.mpegurl&r_range=2403008000-2403056911", "manifest_url": "https://rumble.com/hls-vod/xO7WIkjwvT4/playlist-721.m3u8", "tbr": 4175.0, "ext": "mp4", "protocol": "m3u8_native", "has_drm": false, "width": 1280, "height": 720, "video_ext": "mp4", "audio_ext": "none", "resolution": "1280x720", "dynamic_range": "SDR", "aspect_ratio": 1.78, "http_headers": {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/148.0.0.0 Safari/537.36", "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8", "Accept-Language": "en-us,en;q=0.5", "Sec-Fetch-Mode": "navigate"}, "format": "hls-4175 - 1280x720"}], "subtitles": {"en-auto": [{"url": "https://hugh.cdn.rumble.cloud/video/fwe2/bc/s8/11/q/A/G/2/qAG2A.fn8Si.vtt", "name": "English (auto)", "ext": "vtt"}]}, "thumbnails": [{"url": "https://hugh.cdn.rumble.cloud/video/fwe2/bc/s8/1/q/A/G/2/qAG2A.aiEB-small-VSRF-Live-248-Breaking-The-..jpg", "width": 720, "height": 1280, "id": "0", "resolution": "720x1280"}, {"url": "https://hugh.cdn.rumble.cloud/video/fwe2/bc/s8/1/q/A/G/2/qAG2A.qR4e-small-VSRF-Live-248-Breaking-The-..jpg", "width": 1280, "height": 720, "id": "1", "resolution": "1280x720"}], "timestamp": 1790810118, "channel": "Vaccine Safety Research Foundation", "channel_url": "https://rumble.com/c/VaccineSafetyResearchFoundation", "duration": 4604, "uploader": "Vaccine Safety Research Foundation", "live_status": "was_live", "webpage_url": "https://rumble.com/v7g7p1s-vsrf-live-248-breaking-the-golden-rule-of-pregnancy.html", "webpage_url_basename": "v7g7p1s-vsrf-live-248-breaking-the-golden-rule-of-pregnancy.html", "webpage_url_domain": "rumble.com", "extractor": "RumbleEmbed", "extractor_key": "RumbleEmbed", "release_timestamp": 1791327602, "view_count": 8502, "like_count": 126, "dislike_count": 3, "description": "For generations, medicine followed a fundamental rule when it came to pregnancy: when the safety of a drug or medical intervention for a developing baby is uncertain, proceed with extreme caution. Maternal-fetal medicine specialist Dr. James Thorp calls it the “golden rule of pregnancy.” He says that during the COVID era, that rule was broken.Show more Dr. Thorp has spent more than four decades caring for women with high-risk pregnancies. When COVID vaccines were widely recommended during pregnancy, he became increasingly concerned about what he was seeing in his own practice and about emerging reports of miscarriage, stillbirth, placental abnormalities, menstrual disturbances and other reproductive problems. He began investigating the available safety data and publicly questioning whether potential risks to mothers and babies were being adequately investigated.\nHis concerns extend beyond pregnancy itself. Thorp has also raised questions about potential effects on newborns and infants, including possible exposure through breastfeeding, and argues that troubling safety signals involving some of medicine’s most vulnerable patients have too often been ignored or dismissed.\nHis outspoken position put him at odds with major medical institutions. Thorp challenged the recommendations of leading obstetric and public-health organizations, testified before the U.S. Senate, and continued speaking publicly about what he believed the evidence was showing. In 2023, he was terminated from his position at SSM Health; Thorp has said his advocacy regarding COVID vaccination contributed to his termination.\nThis week on VSRF Live, Dr. James Thorp joins us to discuss what he witnessed treating high-risk pregnancies, the evidence behind his concerns, what we now know about COVID vaccination during pregnancy and its potential effects on mothers and babies, and why he believes medicine abandoned one of its oldest principles: first, protect the mother and child. Show less", "thumbnail": "https://hugh.cdn.rumble.cloud/video/fwe2/bc/s8/1/q/A/G/2/qAG2A.qR4e-small-VSRF-Live-248-Breaking-The-..jpg", "display_id": "v7e1c4a", "fulltitle": "VSRF Live #248 - Breaking The Golden Rule Of Pregnancy", "duration_string": "1:16:44", "upload_date": "20260930", "release_date": "20261006", "release_year": 2026, "is_live": false, "was_live": true, "epoch": 1794326305, "acodec": "aac", "vcodec": "none", "url": "https://hugh.cdn.rumble.cloud/video/fwe2/bc/s8/2/q/A/G/2/qAG2A.Gaa.rec.aac", "format_id": "audio-192p", "tbr": 191, "filesize": 110506737, "width": 0, "height": 192, "protocol": "https", "ext": "aac", "audio_ext": "aac", "video_ext": "none", "vbr": 0, "abr": 191, "resolution": "audio only", "aspect_ratio": 0.0, "http_headers": {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/148.0.0.0 Safari/537.36", "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8", "Accept-Language": "en-us,en;q=0.5", "Sec-Fetch-Mode": "navigate"}, "format": "audio-192p - audio only", "_type": "video", "_version": {"version": "2026.11.04.232659", "release_git_head": "412e7f0a4b0588fe884a02b344ac66a06538475b", "repository": "yt-dlp/yt-dlp-nightly-builds"}}