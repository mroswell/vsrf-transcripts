accine Safety Research Foundation", "channel_url": "https://rumble.com/c/VaccineSafetyResearchFoundation", "duration": 5618, "uploader": "Vaccine Safety Research Foundation", "live_status": "was_live", "webpage_url": "https://rumble.com/v6zo9vm-episode-197-moment-of-truth.html", "webpage_url_basename": "v6zo9vm-episode-197-moment-of-truth.html", "webpage_url_domain": "rumble.com", "extractor": "RumbleEmbed", "extractor_key": "RumbleEmbed", "release_timestamp": 1759446004, "view_count": 8612, "like_count": 142, "dislike_count": 0, "description": "Donations are tax deductible and we need your support to continue our work into 2024. Or to text-to-donate, text VSRF to 53-555Show more This Thursday, VSRF Live welcomes two of the most influential voices in health freedom: Mary Holland, J.D., CEO of Children’s Health Defense (CHD), and Stephanie Locricchio, CHD’s Director of Advocacy & Outreach.\nMary and Stephanie will take us behind the scenes at CHD, sharing where the organization is focusing its energy this fall, the strategies driving their momentum, and the critical role grassroots advocacy plays in defending medical freedom. They’ll also give an exclusive preview of CHD’s upcoming conference — “Moment of Truth,” November 7–9 in Austin, Texas. This year’s theme reflects the urgency of our time: protecting children’s health and medical freedom is not just a cause, but a calling. VSRF is proud to be a sponsor of this important event.\nRegistration for the conference is now OPEN! Don’t miss a weekend of:\n*Interactive sessions on informed consent, vaccine safety, EMR/wireless, parental rights, and more\n*Networking with like-minded professionals, families, and change-makers\n*Solutions rooted in integrity, science, and courage\n*Connection, purpose, and community in the heart of Austin\nExpect a dynamic, in-depth conversation on CHD’s expanding impact, the challenges and opportunities ahead, and why this conference will be a pivotal gathering for advocates, professionals, and families alike.\n📅 Thursday\n⏰ 7pm ET | 4pm PT\n📺 Watch live on Rumble & X\n👉 Bring your questions, share with a friend, and join us for an inspiring discussion — and learn how you can be part of this transformative weekend in Austin. Show less", "thumbnail": "https://1a-1791.com/video/fwe2/ee/s8/1/c/m/I/m/cmImz.qR4e-small-Episode-197-Moment-of-Truth.jpg", "display_id": "v6xhjd2", "fulltitle": "Episode 197: Moment of Truth", "duration_string": "1:33:38", "upload_date": "20250930", "release_date": "20251002", "release_year": 2025, "is_live": false, "was_live": true, "epoch": 1777728036, "acodec": "aac", "vcodec": "none", "url": "https://1a-1791.com/video/fwe2/ee/s8/2/c/m/I/m/cmImz.Gaa.rec.aac", "format_id": "audio-192p", "tbr": 191, "filesize": 134831404, "width": 0, "height": 192, "protocol": "https", "ext": "aac", "audio_ext": "aac", "video_ext": "none", "vbr": 0, "abr": 191, "resolution": "audio only", "aspect_ratio": 0.0, "http_headers": {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/140.0.0.0 Safari/537.36", "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8", "Accept-Language": "en-us,en;q=0.5", "Sec-Fetch-Mode": "navigate"}, "format": "audio-192p - audio only", "_type": "video", "_version": {"version": "2026.01.31", "release_git_head": "9a9a6b6fe44a30458c1754ef064f354f04a84004", "repository": "yt-dlp/yt-dlp"}}