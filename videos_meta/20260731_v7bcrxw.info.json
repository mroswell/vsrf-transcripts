igate"}, "format": "hls-2144-1 - 1280x720"}, {"format_id": "hls-4535", "url": "https://hugh.cdn.rumble.cloud/video/fwe2/d2/s8/2/G/F/w/L/GFwLA.Eaa.rec.tar?r_file=chunklist.m3u8&r_type=application%2Fvnd.apple.mpegurl&r_range=3057878016-3057935375", "manifest_url": "https://rumble.com/hls-vod/KRWLwK84WTY/playlist-721.m3u8", "tbr": 4535.0, "ext": "mp4", "protocol": "m3u8_native", "has_drm": false, "width": 1280, "height": 720, "video_ext": "mp4", "audio_ext": "none", "resolution": "1280x720", "dynamic_range": "SDR", "aspect_ratio": 1.78, "http_headers": {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/148.0.0.0 Safari/537.36", "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8", "Accept-Language": "en-us,en;q=0.5", "Sec-Fetch-Mode": "navigate"}, "format": "hls-4535 - 1280x720"}], "subtitles": {"en-auto": [{"url": "https://hugh.cdn.rumble.cloud/video/fwe2/d2/s8/11/G/F/w/L/GFwLA.fn8Si.vtt", "name": "English (auto)", "ext": "vtt"}]}, "thumbnails": [{"url": "https://hugh.cdn.rumble.cloud/video/fwe2/d2/s8/1/G/F/w/L/GFwLA.aiEB-small-VSRF-Live-239-When-Science-..jpg", "width": 720, "height": 1280, "id": "0", "resolution": "720x1280"}, {"url": "https://hugh.cdn.rumble.cloud/video/fwe2/d2/s8/1/G/F/w/L/GFwLA.qR4e-small-VSRF-Live-239-When-Science-..jpg", "width": 1280, "height": 720, "id": "1", "resolution": "1280x720"}], "timestamp": 1785518026, "channel": "Vaccine Safety Research Foundation", "channel_url": "https://rumble.com/c/VaccineSafetyResearchFoundation", "duration": 5393, "uploader": "Vaccine Safety Research Foundation", "live_status": "was_live", "webpage_url": "https://rumble.com/v7djb34-vsrf-live-239-when-science-stops-asking-questions.html", "webpage_url_basename": "v7djb34-vsrf-live-239-when-science-stops-asking-questions.html", "webpage_url_domain": "rumble.com", "extractor": "RumbleEmbed", "extractor_key": "RumbleEmbed", "release_timestamp": 1785884407, "view_count": 8543, "like_count": 122, "dislike_count": 2, "description": "SIGN THE PETITION👇 End the 40 year reign of terror. Restore accountability and legal liability to vaccine manufacturers. www.vacsafety.org/petitionShow more Science is built on curiosity, skepticism, and the relentless pursuit of truth. Every major scientific breakthrough has been made possible because someone was willing to ask difficult questions, challenge prevailing assumptions, and follow the evidence wherever it led. In science, no hypothesis should be beyond scrutiny, no conclusion beyond challenge, and no researcher should fear asking an unpopular question.\nBut what happens when that process begins to break down? What happens when scientific journals refuse to publish certain findings, researchers face mounting pressure to conform, or published papers are targeted for retraction because they challenge established viewpoints? Can science continue to advance if debate itself becomes unwelcome?\nNext Tuesday, we're joined by Dr. Brian Hooker, Chief Scientific Officer for Children's Health Defense, for a timely discussion on censorship in science, editorial bias, and the growing battle over academic freedom.\nDr. Hooker returns to VSRF Live at a pivotal moment. His recent paper with Karl Jablonowski examining Sudden Infant Death Syndrome (SIDS) has generated significant discussion following Steve Kirsch's analysis of its findings. At the same time, another of Dr. Hooker's peer-reviewed papers is reportedly under consideration for retraction, raising new questions about the integrity of scientific publishing and the increasing use of retractions in controversial areas of research.\nDuring our conversation, Dr. Hooker will discuss his latest research, the reaction from the scientific community, and why he believes open scientific inquiry is facing unprecedented challenges. We'll examine the controversy surrounding the SIDS paper, the role of peer review, the influence of medical journals, and what these developments could mean for the future of scientific research and public trust.\nWhether you're a scientist, physician, student, or simply someone who believes that science advances through open debate rather than censorship, this is a conversation you won't want to miss. Show less", "thumbnail": "https://hugh.cdn.rumble.cloud/video/fwe2/d2/s8/1/G/F/w/L/GFwLA.qR4e-small-VSRF-Live-239-When-Science-..jpg", "display_id": "v7bcrxw", "fulltitle": "VSRF Live #239 - When Science Stops Asking Questions", "duration_string": "1:29:53", "upload_date": "20260731", "release_date": "20260804", "release_year": 2026, "is_live": false, "was_live": true, "epoch": 1794323971, "acodec": "aac", "vcodec": "none", "url": "https://hugh.cdn.rumble.cloud/video/fwe2/d2/s8/2/G/F/w/L/GFwLA.Gaa.rec.aac", "format_id": "audio-192p", "tbr": 191, "filesize": 129446418, "width": 0, "height": 192, "protocol": "https", "ext": "aac", "audio_ext": "aac", "video_ext": "none", "vbr": 0, "abr": 191, "resolution": "audio only", "aspect_ratio": 0.0, "http_headers": {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/148.0.0.0 Safari/537.36", "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8", "Accept-Language": "en-us,en;q=0.5", "Sec-Fetch-Mode": "navigate"}, "format": "audio-192p - audio only", "_type": "video", "_version": {"version": "2026.11.04.232659", "release_git_head": "412e7f0a4b0588fe884a02b344ac66a06538475b", "repository": "yt-dlp/yt-dlp-nightly-builds"}}