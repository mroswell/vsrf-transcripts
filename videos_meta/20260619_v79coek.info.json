": "hls-2144-1 - 1280x720"}, {"format_id": "hls-4696", "url": "https://hugh.cdn.rumble.cloud/video/fww1/b3/s8/2/u/Y/I/y/uYIyA.Eaa.rec.tar?r_file=chunklist.m3u8&r_type=application%2Fvnd.apple.mpegurl&r_range=2954970624-2955024105", "manifest_url": "https://rumble.com/hls-vod/xpv6wtbvJTs/playlist-721.m3u8", "tbr": 4696.0, "ext": "mp4", "protocol": "m3u8_native", "has_drm": false, "width": 1280, "height": 720, "video_ext": "mp4", "audio_ext": "none", "resolution": "1280x720", "dynamic_range": "SDR", "aspect_ratio": 1.78, "http_headers": {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/148.0.0.0 Safari/537.36", "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8", "Accept-Language": "en-us,en;q=0.5", "Sec-Fetch-Mode": "navigate"}, "format": "hls-4696 - 1280x720"}], "subtitles": {"en-auto": [{"url": "https://hugh.cdn.rumble.cloud/video/fww1/b3/s8/11/u/Y/I/y/uYIyA.fn8Si.vtt", "name": "English (auto)", "ext": "vtt"}]}, "thumbnails": [{"url": "https://hugh.cdn.rumble.cloud/video/fww1/b3/s8/1/u/Y/I/y/uYIyA.aiEB.1-small-VSRF-Live-233-The-Cost-Of-S..jpg", "width": 720, "height": 1280, "id": "0", "resolution": "720x1280"}, {"url": "https://hugh.cdn.rumble.cloud/video/fww1/b3/s8/1/u/Y/I/y/uYIyA.qR4e.1-small-VSRF-Live-233-The-Cost-Of-S..jpg", "width": 1280, "height": 720, "id": "1", "resolution": "1280x720"}], "timestamp": 1781898562, "channel": "Vaccine Safety Research Foundation", "channel_url": "https://rumble.com/c/VaccineSafetyResearchFoundation", "duration": 5033, "uploader": "Vaccine Safety Research Foundation", "live_status": "was_live", "webpage_url": "https://rumble.com/v7bjces-vsrf-live-233-the-cost-of-silence.html", "webpage_url_basename": "v7bjces-vsrf-live-233-the-cost-of-silence.html", "webpage_url_domain": "rumble.com", "extractor": "RumbleEmbed", "extractor_key": "RumbleEmbed", "release_timestamp": 1782255640, "view_count": 8479, "like_count": 136, "dislike_count": 0, "description": "SIGN THE PETITION👇 End the 40 year reign of terror. Restore accountability and legal liability to vaccine manufacturers. www.vacsafety.org/petitionShow more The Shot: Sean Hartman's Story and the Fight for Answers\nWhat happens when a healthy teenager dies suddenly, and his family is left searching for answers?\nThis week on VSRF Live, we welcome three special guests – filmmaker Dean Rainey, producer and journalist Jason Lavigne, and Dan Hartman, father of Sean Hartman – for a powerful conversation about the new documentary, “The Shot: Sean Hartman's Story.”\nSean Hartman was a healthy 17-year-old Canadian hockey player with his whole life ahead of him. Following his sudden death shortly after receiving his first Pfizer COVID-19 vaccine, his father embarked on a relentless search for answers. “The Shot” chronicles that journey through interviews, medical records, expert analysis, and the firsthand experiences of a family determined to uncover the truth about what happened to their son.\nWe'll explore the legal battles that followed, including litigation involving Pfizer and an ongoing appeal involving Health Canada that could ultimately reach the Supreme Court of Canada. We'll also discuss the obstacles faced by the filmmakers as they worked to bring Sean's story to audiences across Canada—including screening cancellations, refusals of service, public criticism, and threats—as well as the overwhelming support they received from viewers who believe these stories deserve to be heard.\nMore than a documentary, “The Shot” has become part of a growing conversation about transparency, accountability, informed consent, and the experiences of families who feel their voices have been ignored. The film has helped bring greater public attention to vaccine injury issues in Canada and to efforts that contributed to a parliamentary vaccine injury inquiry scheduled for later this year.\nDean Rainey will also provide an update on Michael Oesch, whose vaccine injury story was featured in Rainey’s documentary, “Why Can't We Talk About This?” Following the release of that film, Michael received an outpouring of support and has experienced meaningful improvements in his health. Dean will discuss Michael's progress, a newly released follow-up documentary chronicling his recovery journey, and his continued advocacy on behalf of the vaccine-injured community.\nJoin us for an important discussion about truth, accountability, documentary filmmaking, and the human cost borne by families still seeking answers long after the headlines have faded.\nBecause sometimes the most powerful stories are the ones people are told not to tell. Show less", "thumbnail": "https://hugh.cdn.rumble.cloud/video/fww1/b3/s8/1/u/Y/I/y/uYIyA.qR4e.1-small-VSRF-Live-233-The-Cost-Of-S..jpg", "display_id": "v79coek", "fulltitle": "VSRF Live #233 - The Cost Of Silence", "duration_string": "1:23:53", "upload_date": "20260619", "release_date": "20260623", "release_year": 2026, "is_live": false, "was_live": true, "epoch": 1794322317, "acodec": "aac", "vcodec": "none", "url": "https://hugh.cdn.rumble.cloud/video/fww1/b3/s8/2/u/Y/I/y/uYIyA.Gaa.rec.aac", "format_id": "audio-192p", "tbr": 192, "filesize": 120801350, "width": 0, "height": 192, "protocol": "https", "ext": "aac", "audio_ext": "aac", "video_ext": "none", "vbr": 0, "abr": 192, "resolution": "audio only", "aspect_ratio": 0.0, "http_headers": {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/148.0.0.0 Safari/537.36", "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8", "Accept-Language": "en-us,en;q=0.5", "Sec-Fetch-Mode": "navigate"}, "format": "audio-192p - audio only", "_type": "video", "_version": {"version": "2026.11.04.232659", "release_git_head": "412e7f0a4b0588fe884a02b344ac66a06538475b", "repository": "yt-dlp/yt-dlp-nightly-builds"}}