": 1751393717, "channel": "Vaccine Safety Research Foundation", "channel_url": "https://rumble.com/c/VaccineSafetyResearchFoundation", "duration": 4489, "uploader": "Vaccine Safety Research Foundation", "live_status": "was_live", "webpage_url": "https://rumble.com/v6vl04x-episode-184-evidence-ethics-and-the-crusade-for-truth.html", "webpage_url_basename": "v6vl04x-episode-184-evidence-ethics-and-the-crusade-for-truth.html", "webpage_url_domain": "rumble.com", "extractor": "RumbleEmbed", "extractor_key": "RumbleEmbed", "release_timestamp": 1751583604, "view_count": 10027, "like_count": 140, "dislike_count": 1, "description": "We are deeply honored to welcome Dr. Tess Lawrie, MBBCh, PhD, to this week’s episode of VSRF LIVE. Dr. Lawrie is a world-renowned researcher, physician, and co-founder of the World Council for Health (WCH)—a global coalition of doctors, scientists, lawyers, and civil society organizations fighting to restore integrity and humanity to public health. Having founded and led the Evidence-Based Medicine Consultancy Ltd (E-BMC Ltd), she uncovered rampant corruption in science and medicine while collaborating with major health bodies like the WHO and UK’s National Health Service, igniting her relentless pursuit to reshape public health policy. Dr. Lawrie has been one of the boldest, clearest, and most compassionate voices throughout the COVID-19 crisis—championing early treatment protocols, informed consent, and medical transparency. Her groundbreaking work has challenged harmful pharmaceutical narratives, exposed corruption in regulatory agencies, empowered doctors and patients around the world, and inspired a people-first movement for health sovereignty. Join us for a powerful conversation as Dr. Lawrie shares the mission and momentum behind the WCH, why centralized medicine is failing—and what comes next, what true public health looks like in a post-COVID world, and how each of us can be part of the solution.\nTune in Thursday at 7 PM ET / 4 PM PT on VSRF LIVE, streaming on Rumble and X.\nAs always, bring your questions and bring your friends!Show more Donations are tax deductible and we need your support to continue our work into 2024. Or to text-to-donate, text VSRF to 53-555 Show less", "thumbnail": "https://1a-1791.com/video/fww1/15/s8/1/X/R/u/Y/XRuYy.qR4e-small-Episode-184-Evidence-Ethics.jpg", "display_id": "v6te3w3", "fulltitle": "Episode 184: Evidence, Ethics, and the Crusade for Truth", "duration_string": "1:14:49", "upload_date": "20250701", "release_date": "20250703", "release_year": 2025, "is_live": false, "was_live": true, "epoch": 1777727466, "acodec": "aac", "vcodec": "none", "url": "https://1a-1791.com/video/fww1/15/s8/2/X/R/u/Y/XRuYy.Gaa.rec.aac", "format_id": "audio-192p", "tbr": 191, "filesize": 107745420, "width": 0, "height": 192, "protocol": "https", "ext": "aac", "audio_ext": "aac", "video_ext": "none", "vbr": 0, "abr": 191, "resolution": "audio only", "aspect_ratio": 0.0, "http_headers": {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/140.0.0.0 Safari/537.36", "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8", "Accept-Language": "en-us,en;q=0.5", "Sec-Fetch-Mode": "navigate"}, "format": "audio-192p - audio only", "_type": "video", "_version": {"version": "2026.01.31", "release_git_head": "9a9a6b6fe44a30458c1754ef064f354f04a84004", "repository": "yt-dlp/yt-dlp"}}