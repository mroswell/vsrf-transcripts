, "format": "hls-2145-1 - 1280x720"}, {"format_id": "hls-4152", "url": "https://hugh.cdn.rumble.cloud/video/fwe2/ba/s8/2/k/J/x/w/kJxwA.Eaa.rec.tar?r_file=chunklist.m3u8&r_type=application%2Fvnd.apple.mpegurl&r_range=2783336448-2783393408", "manifest_url": "https://rumble.com/hls-vod/plE7T3N-9lk/playlist-721.m3u8", "tbr": 4152.0, "ext": "mp4", "protocol": "m3u8_native", "has_drm": false, "width": 1280, "height": 720, "video_ext": "mp4", "audio_ext": "none", "resolution": "1280x720", "dynamic_range": "SDR", "aspect_ratio": 1.78, "http_headers": {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/148.0.0.0 Safari/537.36", "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8", "Accept-Language": "en-us,en;q=0.5", "Sec-Fetch-Mode": "navigate"}, "format": "hls-4152 - 1280x720"}], "subtitles": {"en-auto": [{"url": "https://hugh.cdn.rumble.cloud/video/fwe2/ba/s8/11/k/J/x/w/kJxwA.fn8Si.vtt", "name": "English (auto)", "ext": "vtt"}]}, "thumbnails": [{"url": "https://hugh.cdn.rumble.cloud/video/fwe2/ba/s8/1/k/J/x/w/kJxwA.aiEB-small-VSRF-Live-232-Cancer-Resear..jpg", "width": 720, "height": 1280, "id": "0", "resolution": "720x1280"}, {"url": "https://hugh.cdn.rumble.cloud/video/fwe2/ba/s8/1/k/J/x/w/kJxwA.qR4e-small-VSRF-Live-232-Cancer-Resear..jpg", "width": 1280, "height": 720, "id": "1", "resolution": "1280x720"}], "timestamp": 1781293405, "channel": "Vaccine Safety Research Foundation", "channel_url": "https://rumble.com/c/VaccineSafetyResearchFoundation", "duration": 5362, "uploader": "Vaccine Safety Research Foundation", "live_status": "was_live", "webpage_url": "https://rumble.com/v7b74cq-vsrf-live-232-cancer-research-under-attack.html", "webpage_url_basename": "v7b74cq-vsrf-live-232-cancer-research-under-attack.html", "webpage_url_domain": "rumble.com", "extractor": "RumbleEmbed", "extractor_key": "RumbleEmbed", "release_timestamp": 1781650801, "view_count": 11444, "like_count": 162, "dislike_count": 1, "description": "SIGN THE PETITION👇 End the 40 year reign of terror. Restore accountability and legal liability to vaccine manufacturers. www.vacsafety.org/petitionShow more This week on VSRF Live, we welcome Dr. Angus Dalgleish, one of the world's leading oncologists and cancer immunologists, for a discussion of the June 3 U.S. Senate hearing convened by Senator Ron Johnson: \"Plausible Mechanisms of COVID-19 Injections Causing Cancer and Attacks on Scientific Publications and Research.\"\nDr. Dalgleish is Professor Emeritus of Oncology at City St George's, University of London and a pioneer in the fields of cancer immunotherapy and HIV research. Over the past several years, he has become one of the most prominent voices raising concerns about unusual cancer patterns he and other physicians report observing in clinical practice following the global COVID-19 vaccination campaign. (GB News)\nThe June 3 hearing brought together oncologists, physicians, researchers, and a cancer survivor to examine evidence surrounding potential biological mechanisms that could contribute to cancer development or progression, as well as allegations that scientists investigating these questions have faced obstacles in publishing their findings and obtaining serious consideration from public health institutions. Witnesses included Professor Dalgleish, Dr. Saskia Mostert, Dr. Aseem Malhotra, Dr. Wafik El-Deiry, Dr. Sabine Hazan, and others. (Homeland Security Committee)\nMany participants described the hearing as a significant moment in the ongoing debate surrounding vaccine safety, cancer biology, and scientific transparency. Commentators noted that the discussion extended beyond individual patient reports to focus on proposed biological mechanisms, published research, and the broader question of whether legitimate scientific inquiry has been discouraged or suppressed. (Meryl Nass Substack)\nIn this special episode, Dr. Dalgleish will provide a firsthand account of the hearing, discuss the evidence presented to the Senate, explain why he believes these questions deserve further investigation, and share his perspective on the future of cancer research, vaccine safety science, and scientific freedom.\nJoin us for an in-depth conversation about one of the most consequential public discussions to date on cancer, COVID-19 vaccines, and the role of open scientific debate in addressing complex and controversial medical questions. Show less", "thumbnail": "https://hugh.cdn.rumble.cloud/video/fwe2/ba/s8/1/k/J/x/w/kJxwA.qR4e-small-VSRF-Live-232-Cancer-Resear..jpg", "display_id": "v790gci", "fulltitle": "VSRF Live #232 - Cancer Research Under Attack", "duration_string": "1:29:22", "upload_date": "20260612", "release_date": "20260616", "release_year": 2026, "is_live": false, "was_live": true, "epoch": 1794322236, "acodec": "aac", "vcodec": "none", "url": "https://hugh.cdn.rumble.cloud/video/fwe2/ba/s8/2/k/J/x/w/kJxwA.Gaa.rec.aac", "format_id": "audio-192p", "tbr": 191, "filesize": 128705794, "width": 0, "height": 192, "protocol": "https", "ext": "aac", "audio_ext": "aac", "video_ext": "none", "vbr": 0, "abr": 191, "resolution": "audio only", "aspect_ratio": 0.0, "http_headers": {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/148.0.0.0 Safari/537.36", "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8", "Accept-Language": "en-us,en;q=0.5", "Sec-Fetch-Mode": "navigate"}, "format": "audio-192p - audio only", "_type": "video", "_version": {"version": "2026.11.04.232659", "release_git_head": "412e7f0a4b0588fe884a02b344ac66a06538475b", "repository": "yt-dlp/yt-dlp-nightly-builds"}}