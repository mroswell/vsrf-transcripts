te"}, "format": "hls-2144-1 - 1280x720"}, {"format_id": "hls-4473", "url": "https://hugh.cdn.rumble.cloud/video/fwe2/62/s8/2/m/v/g/H/mvgHA.Eaa.rec.tar?r_file=chunklist.m3u8&r_type=application%2Fvnd.apple.mpegurl&r_range=3622747136-3622815969", "manifest_url": "https://rumble.com/hls-vod/8uP2roPCoFs/playlist-721.m3u8", "tbr": 4473.0, "ext": "mp4", "protocol": "m3u8_native", "has_drm": false, "width": 1280, "height": 720, "video_ext": "mp4", "audio_ext": "none", "resolution": "1280x720", "dynamic_range": "SDR", "aspect_ratio": 1.78, "http_headers": {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/148.0.0.0 Safari/537.36", "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8", "Accept-Language": "en-us,en;q=0.5", "Sec-Fetch-Mode": "navigate"}, "format": "hls-4473 - 1280x720"}], "subtitles": {"en-auto": [{"url": "https://hugh.cdn.rumble.cloud/video/fwe2/62/s8/11/m/v/g/H/mvgHA.fn8Si.vtt", "name": "English (auto)", "ext": "vtt"}]}, "thumbnails": [{"url": "https://hugh.cdn.rumble.cloud/video/fwe2/62/s8/1/m/v/g/H/mvgHA.aiEB-small-VSRF-Live-237-New-Hope-For-..jpg", "width": 720, "height": 1280, "id": "0", "resolution": "720x1280"}, {"url": "https://hugh.cdn.rumble.cloud/video/fwe2/62/s8/1/m/v/g/H/mvgHA.qR4e-small-VSRF-Live-237-New-Hope-For-..jpg", "width": 1280, "height": 720, "id": "1", "resolution": "1280x720"}], "timestamp": 1784305095, "channel": "Vaccine Safety Research Foundation", "channel_url": "https://rumble.com/c/VaccineSafetyResearchFoundation", "duration": 6478, "uploader": "Vaccine Safety Research Foundation", "live_status": "was_live", "webpage_url": "https://rumble.com/v7cvex8-vsrf-live-237-new-hope-for-the-vaccine-injured.html", "webpage_url_basename": "v7cvex8-vsrf-live-237-new-hope-for-the-vaccine-injured.html", "webpage_url_domain": "rumble.com", "extractor": "RumbleEmbed", "extractor_key": "RumbleEmbed", "release_timestamp": 1784674807, "view_count": 11720, "like_count": 157, "dislike_count": 2, "description": "SIGN THE PETITION👇 End the 40 year reign of terror. Restore accountability and legal liability to vaccine manufacturers. www.vacsafety.org/petitionShow more The Edogawa Protocol: A Breakthrough for Long COVID and Vaccine Injury?\nMillions of people continue to live with debilitating symptoms months—or even years—after COVID-19 infection or vaccination. Many report chronic fatigue, neurological problems, cardiovascular symptoms, cognitive impairment, and other life-altering conditions, yet effective treatments remain elusive, and many patients say they have struggled to find physicians willing or able to help.\nThis week on VSRF Live, we welcome neuroscientist Dr. Kevin McCairn and Dr. Mary Talley Bowden for an in-depth discussion of the Edogawa Protocol, an emerging treatment approach developed in Japan that has attracted growing international attention. The protocol incorporates Double Filtration Plasmapheresis (DFPP) along with other therapeutic strategies aimed at addressing what its developers believe are key biological drivers of persistent illness, rather than simply managing symptoms.\nTogether, Drs. McCairn and Bowden will discuss why some patients continue to experience long-term symptoms following COVID-19 infection or vaccination, what current medicine may be overlooking, and whether new treatment strategies could offer hope where conventional approaches have fallen short. They'll also examine the science behind the protocol, including neuroinflammation, immune dysregulation, vascular dysfunction, mitochondrial health, and other mechanisms that have been proposed as contributors to chronic illness.\nThe conversation will also explore the practical questions many patients are asking: What is Double Filtration Plasmapheresis? How is it being used in Japan? What clinical outcomes have physicians observed so far? What research is still needed? And what would it take for this treatment to become available in the United States?\nCould medicine be overlooking key drivers of Long COVID and post-vaccination illness? Is a fundamentally different treatment approach needed? Join us for a timely and thought-provoking discussion exploring one of the most talked-about emerging treatment strategies for patients living with persistent chronic illness. Show less", "thumbnail": "https://hugh.cdn.rumble.cloud/video/fwe2/62/s8/1/m/v/g/H/mvgHA.qR4e-small-VSRF-Live-237-New-Hope-For-..jpg", "display_id": "v7aotmy", "fulltitle": "VSRF Live #237 - New Hope For The Vaccine Injured", "duration_string": "1:47:58", "upload_date": "20260717", "release_date": "20260721", "release_year": 2026, "is_live": false, "was_live": true, "epoch": 1794323283, "acodec": "aac", "vcodec": "none", "url": "https://hugh.cdn.rumble.cloud/video/fwe2/62/s8/2/m/v/g/H/mvgHA.Gaa.rec.aac", "format_id": "audio-192p", "tbr": 191, "filesize": 155486947, "width": 0, "height": 192, "protocol": "https", "ext": "aac", "audio_ext": "aac", "video_ext": "none", "vbr": 0, "abr": 191, "resolution": "audio only", "aspect_ratio": 0.0, "http_headers": {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/148.0.0.0 Safari/537.36", "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8", "Accept-Language": "en-us,en;q=0.5", "Sec-Fetch-Mode": "navigate"}, "format": "audio-192p - audio only", "_type": "video", "_version": {"version": "2026.11.04.232659", "release_git_head": "412e7f0a4b0588fe884a02b344ac66a06538475b", "repository": "yt-dlp/yt-dlp-nightly-builds"}}