h-Mode": "navigate"}, "format": "hls-2145-1 - 1280x720"}, {"format_id": "hls-4992", "url": "https://hugh.cdn.rumble.cloud/video/fww1/26/s8/2/k/s/s/Y/kssYA.Eaa.rec.tar?r_file=chunklist.m3u8&r_type=application%2Fvnd.apple.mpegurl&r_range=2512661504-2512704240", "manifest_url": "https://rumble.com/hls-vod/3oYO1dc406g/playlist-721.m3u8", "tbr": 4992.0, "ext": "mp4", "protocol": "m3u8_native", "has_drm": false, "width": 1280, "height": 720, "video_ext": "mp4", "audio_ext": "none", "resolution": "1280x720", "dynamic_range": "SDR", "aspect_ratio": 1.78, "http_headers": {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/148.0.0.0 Safari/537.36", "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8", "Accept-Language": "en-us,en;q=0.5", "Sec-Fetch-Mode": "navigate"}, "format": "hls-4992 - 1280x720"}], "subtitles": {"en-auto": [{"url": "https://hugh.cdn.rumble.cloud/video/fww1/26/s8/11/k/s/s/Y/kssYA.fn8Si.vtt", "name": "English (auto)", "ext": "vtt"}]}, "thumbnails": [{"url": "https://hugh.cdn.rumble.cloud/video/fww1/26/s8/1/k/s/s/Y/kssYA.aiEB-small-VSRF-LiveEP-245-Warrior-Mom..jpg", "width": 720, "height": 1280, "id": "0", "resolution": "720x1280"}, {"url": "https://hugh.cdn.rumble.cloud/video/fww1/26/s8/1/k/s/s/Y/kssYA.qR4e-small-VSRF-LiveEP-245-Warrior-Mom..jpg", "width": 1280, "height": 720, "id": "1", "resolution": "1280x720"}], "timestamp": 1789513404, "channel": "Vaccine Safety Research Foundation", "channel_url": "https://rumble.com/c/VaccineSafetyResearchFoundation", "duration": 4026, "uploader": "Vaccine Safety Research Foundation", "live_status": "was_live", "webpage_url": "https://rumble.com/v7fjzbe-vsrf-liveep-245-warrior-mom-leading-the-battle-against-autism.html", "webpage_url_basename": "v7fjzbe-vsrf-liveep-245-warrior-mom-leading-the-battle-against-autism.html", "webpage_url_domain": "rumble.com", "extractor": "RumbleEmbed", "extractor_key": "RumbleEmbed", "release_timestamp": 1789513393, "view_count": 4682, "like_count": 70, "dislike_count": 1, "description": "SIGN THE PETITION👇 End the 40 year reign of terror. Restore accountability and legal liability to vaccine manufacturers. www.vacsafety.org/petitionShow more What happens when a mother who spent years fighting for answers for her own child gets a seat at the table where America’s autism priorities are being set?\nThis week on VSRF Live, we welcome Tracy Slepcevic, founder of Autism Health and the annual Autism Health Summit, author of Warrior Mom: A Mother’s Journey in Healing Her Son with Autism, and a member of the federal Interagency Autism Coordinating Committee (IACC).\nTracy’s journey began with her son, Noah, who experienced profound developmental regression as a toddler. Refusing to accept that nothing could be done, she spent years searching for answers, investigating underlying medical issues, and pursuing interventions that she says helped her son recover significant function. That experience transformed her into a fierce advocate for children with autism and families seeking answers about causes, treatments, and recovery.\nToday, Tracy is bringing that perspective directly into the federal autism conversation.\nLast month, she participated in a pivotal IACC meeting as the committee debated and approved its 2026–2028 Strategic Plan, setting priorities for federal autism research, health care, services, and supports. The meeting exposed sharp disagreements over some of the most consequential questions facing the autism community—and over what the federal government should be doing to answer them.\nTracy joins us to take us inside that meeting: What were the biggest battles? Why did so many federal representatives abstain from the final vote? What changed in the new Strategic Plan? And will its priorities translate into meaningful research and better care for children and families?\nWe’ll also discuss the questions Tracy has spent years fighting to bring into the open: What is driving the dramatic rise in autism? Why do some children experience sudden developmental regression? Are environmental contributors receiving the investigation they deserve? Are the complex medical conditions experienced by many children with autism being adequately recognized and treated? And what have families learned that the medical establishment has too often failed to hear?\nFrom one mother’s fight for her son to a seat at the national policy table, Tracy Slepcevic has made autism her life’s mission. Show less", "thumbnail": "https://hugh.cdn.rumble.cloud/video/fww1/26/s8/1/k/s/s/Y/kssYA.qR4e-small-VSRF-LiveEP-245-Warrior-Mom..jpg", "display_id": "v7ddmdw", "fulltitle": "VSRF Live EP #245 - Warrior Mom: Leading The Battle Against Autism", "duration_string": "1:07:06", "upload_date": "20260915", "release_date": "20260915", "release_year": 2026, "is_live": false, "was_live": true, "epoch": 1794325541, "acodec": "aac", "vcodec": "none", "url": "https://hugh.cdn.rumble.cloud/video/fww1/26/s8/2/k/s/s/Y/kssYA.Gaa.rec.aac", "format_id": "audio-192p", "tbr": 192, "filesize": 96631606, "width": 0, "height": 192, "protocol": "https", "ext": "aac", "audio_ext": "aac", "video_ext": "none", "vbr": 0, "abr": 192, "resolution": "audio only", "aspect_ratio": 0.0, "http_headers": {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/148.0.0.0 Safari/537.36", "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8", "Accept-Language": "en-us,en;q=0.5", "Sec-Fetch-Mode": "navigate"}, "format": "audio-192p - audio only", "_type": "video", "_version": {"version": "2026.11.04.232659", "release_git_head": "412e7f0a4b0588fe884a02b344ac66a06538475b", "repository": "yt-dlp/yt-dlp-nightly-builds"}}