rmat": "hls-2142-1 - 1280x720"}, {"format_id": "hls-3428", "url": "https://hugh.cdn.rumble.cloud/video/fwe2/d2/s8/2/O/J/V/0/OJV0A.Eaa.rec.tar?r_file=chunklist.m3u8&r_type=application%2Fvnd.apple.mpegurl&r_range=1673801216-1673842541", "manifest_url": "https://rumble.com/hls-vod/njtq5-Lcnns/playlist-721.m3u8", "tbr": 3428.0, "ext": "mp4", "protocol": "m3u8_native", "has_drm": false, "width": 1280, "height": 720, "video_ext": "mp4", "audio_ext": "none", "resolution": "1280x720", "dynamic_range": "SDR", "aspect_ratio": 1.78, "http_headers": {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/148.0.0.0 Safari/537.36", "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8", "Accept-Language": "en-us,en;q=0.5", "Sec-Fetch-Mode": "navigate"}, "format": "hls-3428 - 1280x720"}], "subtitles": {"en-auto": [{"url": "https://hugh.cdn.rumble.cloud/video/fwe2/d2/s8/11/O/J/V/0/OJV0A.fn8Si.vtt", "name": "English (auto)", "ext": "vtt"}]}, "thumbnails": [{"url": "https://hugh.cdn.rumble.cloud/video/fwe2/d2/s8/1/O/J/V/0/OJV0A.aiEB-small-VSRF-Live-246-The-Death-Dat..jpg", "width": 720, "height": 1280, "id": "0", "resolution": "720x1280"}, {"url": "https://hugh.cdn.rumble.cloud/video/fwe2/d2/s8/1/O/J/V/0/OJV0A.qR4e-small-VSRF-Live-246-The-Death-Dat..jpg", "width": 1280, "height": 720, "id": "1", "resolution": "1280x720"}], "timestamp": 1790276087, "channel": "Vaccine Safety Research Foundation", "channel_url": "https://rumble.com/c/VaccineSafetyResearchFoundation", "duration": 3905, "uploader": "Vaccine Safety Research Foundation", "live_status": "was_live", "webpage_url": "https://rumble.com/v7fxsdk-vsrf-live-246-the-death-data-deception.html", "webpage_url_basename": "v7fxsdk-vsrf-live-246-the-death-data-deception.html", "webpage_url_domain": "rumble.com", "extractor": "RumbleEmbed", "extractor_key": "RumbleEmbed", "release_timestamp": 1790722805, "view_count": 8382, "like_count": 124, "dislike_count": 1, "description": "What if the way deaths are officially recorded is hiding the true story of what is actually killing Americans?Show more This week on VSRF Live, data analyst and researcher John Beaudoin, Sr. returns to take us deep inside the nation's mortality data—and what he says are profound problems with the way deaths are recorded, coded and ultimately presented to the public.\nFor years, Beaudoin has pursued the records behind the statistics. Through public-records requests, he has obtained and analyzed more than 1.6 million death certificates, comparing individual records with federal mortality data and cross-referencing deaths with reports submitted to the Vaccine Adverse Event Reporting System (VAERS). His work has focused particularly on deaths during and after the COVID era and on cases in which the medical history contained in the underlying records appears to tell a different story from the official cause-of-death data.\nAmong Beaudoin's most significant findings is a dramatic rise in deaths involving acute kidney and renal failure beginning in 2020. He argues that the magnitude of that increase is obscured when researchers look only at the designated \"underlying cause of death,\" rather than examining all conditions recorded on death certificates. His analysis of CDC mortality data finds acute renal failure appearing on hundreds of thousands more death records as a multiple cause than as the underlying cause alone.\nBeaudoin has also compared death certificates with VAERS reports and examined the ICD codes used to identify vaccine-related deaths. He contends that these records reveal serious inconsistencies—including cases in which vaccination was documented in connection with a death but was absent from the mortality coding ultimately used for national statistics. He argues that some deaths attributed to COVID-19 likewise deserve renewed scrutiny based on the individual medical records and circumstances surrounding those deaths.\nNow, his investigation is raising an even bigger question: How much can we trust what we think we know about the leading causes of death in America when the underlying data itself may be incomplete, miscoded or misleading?\nJohn joins us to show the records, explain how death-certificate data become national mortality statistics, and reveal why he believes some of our most fundamental assumptions about what is killing Americans need to be reexamined.\nJoin us for Death by Data Manipulation—this week on VSRF Live. Show less", "thumbnail": "https://hugh.cdn.rumble.cloud/video/fwe2/d2/s8/1/O/J/V/0/OJV0A.qR4e-small-VSRF-Live-246-The-Death-Dat..jpg", "display_id": "v7drfg2", "fulltitle": "VSRF Live #247 - The Death Data Deception", "duration_string": "1:05:05", "upload_date": "20260924", "release_date": "20260929", "release_year": 2026, "is_live": false, "was_live": true, "epoch": 1794326158, "acodec": "aac", "vcodec": "none", "url": "https://hugh.cdn.rumble.cloud/video/fwe2/d2/s8/2/O/J/V/0/OJV0A.Gaa.rec.aac", "format_id": "audio-192p", "tbr": 192, "filesize": 93742673, "width": 0, "height": 192, "protocol": "https", "ext": "aac", "audio_ext": "aac", "video_ext": "none", "vbr": 0, "abr": 192, "resolution": "audio only", "aspect_ratio": 0.0, "http_headers": {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/148.0.0.0 Safari/537.36", "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8", "Accept-Language": "en-us,en;q=0.5", "Sec-Fetch-Mode": "navigate"}, "format": "audio-192p - audio only", "_type": "video", "_version": {"version": "2026.11.04.232659", "release_git_head": "412e7f0a4b0588fe884a02b344ac66a06538475b", "repository": "yt-dlp/yt-dlp-nightly-builds"}}