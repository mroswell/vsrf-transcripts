 "format": "hls-2145-1 - 1280x720"}, {"format_id": "hls-4181", "url": "https://hugh.cdn.rumble.cloud/video/fwe2/06/s8/2/A/d/P/A/AdPAA.Eaa.rec.tar?r_file=chunklist.m3u8&r_type=application%2Fvnd.apple.mpegurl&r_range=2015899648-2015940488", "manifest_url": "https://rumble.com/hls-vod/UbluQtvZ8Dc/playlist-721.m3u8", "tbr": 4181.0, "ext": "mp4", "protocol": "m3u8_native", "has_drm": false, "width": 1280, "height": 720, "video_ext": "mp4", "audio_ext": "none", "resolution": "1280x720", "dynamic_range": "SDR", "aspect_ratio": 1.78, "http_headers": {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/148.0.0.0 Safari/537.36", "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8", "Accept-Language": "en-us,en;q=0.5", "Sec-Fetch-Mode": "navigate"}, "format": "hls-4181 - 1280x720"}], "subtitles": {"en-auto": [{"url": "https://hugh.cdn.rumble.cloud/video/fwe2/06/s8/11/A/d/P/A/AdPAA.fn8Si.vtt", "name": "English (auto)", "ext": "vtt"}]}, "thumbnails": [{"url": "https://hugh.cdn.rumble.cloud/video/fwe2/06/s8/1/A/d/P/A/AdPAA.aiEB-small-VSRF-Live-234-The-Trends-Re..jpg", "width": 720, "height": 1280, "id": "0", "resolution": "720x1280"}, {"url": "https://hugh.cdn.rumble.cloud/video/fwe2/06/s8/1/A/d/P/A/AdPAA.qR4e-small-VSRF-Live-234-The-Trends-Re..jpg", "width": 1280, "height": 720, "id": "1", "resolution": "1280x720"}], "timestamp": 1782492602, "channel": "Vaccine Safety Research Foundation", "channel_url": "https://rumble.com/c/VaccineSafetyResearchFoundation", "duration": 3857, "uploader": "Vaccine Safety Research Foundation", "live_status": "was_live", "webpage_url": "https://rumble.com/v7bv4re-vsrf-live-234-the-trends-reshaping-society.html", "webpage_url_basename": "v7bv4re-vsrf-live-234-the-trends-reshaping-society.html", "webpage_url_domain": "rumble.com", "extractor": "RumbleEmbed", "extractor_key": "RumbleEmbed", "release_timestamp": 1782860418, "view_count": 12636, "like_count": 178, "dislike_count": 0, "description": "SIGN THE PETITION👇 End the 40 year reign of terror. Restore accountability and legal liability to vaccine manufacturers. www.vacsafety.org/petitionShow more This week on VSRF Live, former Wall Street portfolio manager and financial analyst Ed Dowd returns for a timely conversation about the data, technology, and economic forces shaping both present trends and the future.\nAs the founder of Phinance Technologies and author of Cause Unknown: The Epidemic of Sudden Deaths in 2021 & 2022, Dowd has become known for applying financial market analysis to complex public datasets, asking difficult questions, and identifying trends that others may overlook.\nComing up Tuesday, Steve Kirsch sits down with Ed to examine the latest excess mortality data, what Wall Street taught him about recognizing patterns long before they become obvious, and how artificial intelligence could fundamentally reshape the economy, employment, investing, and everyday life.\nThe conversation also explores the growing intersection of AI, digital identity, finance, and government oversight, and asks whether these technologies will ultimately expand human potential or concentrate unprecedented power.\nJust as importantly, Steve and Ed will tackle the questions that linger long after the data is presented: Will there ever be accountability? Has society reached a point where meaningful dialogue is no longer possible? In an era where many people seem unwilling to question their own assumptions—or engage with those who see the world differently—how do we bridge an increasingly divided public, and what does that mean for the future?\nWhether you've followed Ed's work in finance or know him from his more recent data analysis, this promises to be a thought-provoking conversation about some of the most consequential issues of our time—and where the evidence may be pointing next. Show less", "thumbnail": "https://hugh.cdn.rumble.cloud/video/fwe2/06/s8/1/A/d/P/A/AdPAA.qR4e-small-VSRF-Live-234-The-Trends-Re..jpg", "display_id": "v79ogr6", "fulltitle": "VSRF Live #234 - The Trends Reshaping Society", "duration_string": "1:04:17", "upload_date": "20260626", "release_date": "20260630", "release_year": 2026, "is_live": false, "was_live": true, "epoch": 1794322493, "acodec": "aac", "vcodec": "none", "url": "https://hugh.cdn.rumble.cloud/video/fwe2/06/s8/2/A/d/P/A/AdPAA.Gaa.rec.aac", "format_id": "audio-192p", "tbr": 191, "filesize": 92569043, "width": 0, "height": 192, "protocol": "https", "ext": "aac", "audio_ext": "aac", "video_ext": "none", "vbr": 0, "abr": 191, "resolution": "audio only", "aspect_ratio": 0.0, "http_headers": {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/148.0.0.0 Safari/537.36", "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8", "Accept-Language": "en-us,en;q=0.5", "Sec-Fetch-Mode": "navigate"}, "format": "audio-192p - audio only", "_type": "video", "_version": {"version": "2026.11.04.232659", "release_git_head": "412e7f0a4b0588fe884a02b344ac66a06538475b", "repository": "yt-dlp/yt-dlp-nightly-builds"}}