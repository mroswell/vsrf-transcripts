"timestamp": 1765929341, "channel": "Vaccine Safety Research Foundation", "channel_url": "https://rumble.com/c/VaccineSafetyResearchFoundation", "duration": 7069, "uploader": "Vaccine Safety Research Foundation", "live_status": "was_live", "webpage_url": "https://rumble.com/v7340k8-episode-208-pregnancy-pharmaceuticals-and-the-question-of-risk-with-dr.-ada.html", "webpage_url_basename": "v7340k8-episode-208-pregnancy-pharmaceuticals-and-the-question-of-risk-with-dr.-ada.html", "webpage_url_domain": "rumble.com", "extractor": "RumbleEmbed", "extractor_key": "RumbleEmbed", "release_timestamp": 1766102403, "view_count": 6207, "like_count": 104, "dislike_count": 0, "description": "Donations are tax deductible and we need your support to continue our work. Text-to-donate, text VSRF to 53555.Show more This Thursday, we’re thrilled to welcome Dr. Adam Urato, an obstetrician–gynecologist and maternal-fetal medicine physician. He is board certified and has spent nearly 30 years caring for pregnant women, including those with high-risk pregnancies.\nDr. Urato writes and lectures extensively on medication exposures during pregnancy, with a particular focus on antidepressants and other pharmaceutical drugs. He has taken a leading role in challenging ineffective and harmful approaches to pregnancy care, including Makena, a preterm-birth drug removed from the market by the FDA in 2023.\nHe is a strong advocate for informed consent, patient-centered counseling, and freedom of speech in medicine. His work emphasizes a clear but compassionate approach: recognizing the importance of maternal mental health while also carefully examining the effects of chemical exposures on developing babies.\nTonight’s discussion will include:\n*The use of antidepressants and other medications during pregnancy\n*What we do and do not know about how chemical exposures may affect fetal development\n*The importance of informed consent, individualized care, and honest risk–benefit conversations for women of childbearing age\n*Why Dr. Urato emphasizes a simple but often overlooked principle: “chemicals have consequences.”\nThis promises to be a thoughtful, science-based, and deeply human conversation about pregnancy, medicine, and informed decision-making.\nJoin us live this Thursday.\n⏰ Time: 7 pm ET, 4 pm PT\n📺 Watch on Rumble and X Show less", "thumbnail": "https://1a-1791.com/video/fwe2/8d/s8/1/y/R/J/I/yRJIz.qR4e-small-Episode-208-Pregnancy-Pharm.jpg", "display_id": "v70xck0", "fulltitle": "Episode 208: Pregnancy, Pharmaceuticals, and the Question of Risk", "duration_string": "1:57:49", "upload_date": "20251216", "release_date": "20251219", "release_year": 2025, "is_live": false, "was_live": true, "epoch": 1777728512, "acodec": "aac", "vcodec": "none", "url": "https://1a-1791.com/video/fwe2/8d/s8/2/y/R/J/I/yRJIz.Gaa.rec.aac", "format_id": "audio-192p", "tbr": 191, "filesize": 169661336, "width": 0, "height": 192, "protocol": "https", "ext": "aac", "audio_ext": "aac", "video_ext": "none", "vbr": 0, "abr": 191, "resolution": "audio only", "aspect_ratio": 0.0, "http_headers": {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/140.0.0.0 Safari/537.36", "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8", "Accept-Language": "en-us,en;q=0.5", "Sec-Fetch-Mode": "navigate"}, "format": "audio-192p - audio only", "_type": "video", "_version": {"version": "2026.01.31", "release_git_head": "9a9a6b6fe44a30458c1754ef064f354f04a84004", "repository": "yt-dlp/yt-dlp"}}