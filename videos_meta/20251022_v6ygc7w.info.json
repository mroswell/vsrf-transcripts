"channel": "Vaccine Safety Research Foundation", "channel_url": "https://rumble.com/c/VaccineSafetyResearchFoundation", "duration": 5705, "uploader": "Vaccine Safety Research Foundation", "live_status": "was_live", "webpage_url": "https://rumble.com/v70n060-episode-200-the-silent-crisis-in-farming.html", "webpage_url_basename": "v70n060-episode-200-the-silent-crisis-in-farming.html", "webpage_url_domain": "rumble.com", "extractor": "RumbleEmbed", "extractor_key": "RumbleEmbed", "release_timestamp": 1761260411, "view_count": 6557, "like_count": 115, "dislike_count": 1, "description": "Donations are tax deductible and we need your support to continue our work into 2024. Or to text-to-donate, text VSRF to 53-555Show more Dr. Meryl Nass is a board-certified physician and researcher with more than 40 years of experience in internal medicine. She was the first person to prove that an epidemic was caused by biological warfare and has since become a nationally recognized expert on bioterrorism, epidemics, and vaccine safety. Over her career, she has advised governments and public health agencies around the world on outbreaks including anthrax, Zika, and Ebola.\nAfter decades exposing corruption in medicine and public health, Dr. Nass is now turning her attention to another urgent front — the crisis in farming and the future of food. She warns that policies threatening small farmers, seed sovereignty, and traditional agriculture are endangering not only food security but human freedom itself.\nAs the founder of DoorToFreedom.org and leader of the Save Our Food and Farms initiative with Children’s Health Defense and the MAHA Institute, Dr. Nass is bringing together farmers, consumers, and advocates to protect local food systems and rebuild independent agriculture. She continues to write extensively on health policy, global governance, and the farming crisis on her Substack.\nJoin us this Thursday on VSRF Live as Dr. Nass connects the dots between public health, policy, and food freedom—and explains why protecting our farms is the next great battle for our survival and sovereignty. Show less", "thumbnail": "https://1a-1791.com/video/fww1/b9/s8/1/y/Y/T/s/yYTsz.qR4e-small-Episode-200-The-Silent-Cris.jpg", "display_id": "v6ygc7w", "fulltitle": "Episode 200: The Silent Crisis In Farming", "duration_string": "1:35:05", "upload_date": "20251022", "release_date": "20251023", "release_year": 2025, "is_live": false, "was_live": true, "epoch": 1777728174, "acodec": "aac", "vcodec": "none", "url": "https://1a-1791.com/video/fww1/b9/s8/2/y/Y/T/s/yYTsz.Gaa.rec.aac", "format_id": "audio-192p", "tbr": 192, "filesize": 136927887, "width": 0, "height": 192, "protocol": "https", "ext": "aac", "audio_ext": "aac", "video_ext": "none", "vbr": 0, "abr": 192, "resolution": "audio only", "aspect_ratio": 0.0, "http_headers": {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/140.0.0.0 Safari/537.36", "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8", "Accept-Language": "en-us,en;q=0.5", "Sec-Fetch-Mode": "navigate"}, "format": "audio-192p - audio only", "_type": "video", "_version": {"version": "2026.01.31", "release_git_head": "9a9a6b6fe44a30458c1754ef064f354f04a84004", "repository": "yt-dlp/yt-dlp"}}