etch-Mode": "navigate"}, "format": "hls-2145-1 - 1280x720"}, {"format_id": "hls-5054", "url": "https://hugh.cdn.rumble.cloud/video/fww1/93/s8/2/C/7/m/P/C7mPA.Eaa.rec.tar?r_file=chunklist.m3u8&r_type=application%2Fvnd.apple.mpegurl&r_range=3492477440-3492536199", "manifest_url": "https://rumble.com/hls-vod/-U5n0sJhTYc/playlist-721.m3u8", "tbr": 5054.0, "ext": "mp4", "protocol": "m3u8_native", "has_drm": false, "width": 1280, "height": 720, "video_ext": "mp4", "audio_ext": "none", "resolution": "1280x720", "dynamic_range": "SDR", "aspect_ratio": 1.78, "http_headers": {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/148.0.0.0 Safari/537.36", "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8", "Accept-Language": "en-us,en;q=0.5", "Sec-Fetch-Mode": "navigate"}, "format": "hls-5054 - 1280x720"}], "subtitles": {"en-auto": [{"url": "https://hugh.cdn.rumble.cloud/video/fww1/93/s8/11/C/7/m/P/C7mPA.fn8Si.vtt", "name": "English (auto)", "ext": "vtt"}]}, "thumbnails": [{"url": "https://hugh.cdn.rumble.cloud/video/fww1/93/s8/1/C/7/m/P/C7mPA.aiEB-small-VSRF-Live-241-Canada-Reopen..jpg", "width": 720, "height": 1280, "id": "0", "resolution": "720x1280"}, {"url": "https://hugh.cdn.rumble.cloud/video/fww1/93/s8/1/C/7/m/P/C7mPA.qR4e-small-VSRF-Live-241-Canada-Reopen..jpg", "width": 1280, "height": 720, "id": "1", "resolution": "1280x720"}], "timestamp": 1786658146, "channel": "Vaccine Safety Research Foundation", "channel_url": "https://rumble.com/c/VaccineSafetyResearchFoundation", "duration": 5527, "uploader": "Vaccine Safety Research Foundation", "live_status": "was_live", "webpage_url": "https://rumble.com/v7e4xy4-vsrf-live-241-canada-reopens-the-record-on-covid-vaccine-injuries.html", "webpage_url_basename": "v7e4xy4-vsrf-live-241-canada-reopens-the-record-on-covid-vaccine-injuries.html", "webpage_url_domain": "rumble.com", "extractor": "RumbleEmbed", "extractor_key": "RumbleEmbed", "release_timestamp": 1787094000, "view_count": 10001, "like_count": 129, "dislike_count": 0, "description": "SIGN THE PETITION👇 End the 40 year reign of terror. Restore accountability and legal liability to vaccine manufacturers. www.vacsafety.org/petitionShow more For years, thousands of Canadians who say they were injured by COVID-19 vaccines have sought recognition, accountability, and answers. Many have shared stories of devastating health complications, financial hardship, and the struggle simply to have their experiences acknowledged. Now, those voices are set to be heard through The Allison Inquiry, a new parliamentary inquiry focused specifically on COVID-19 vaccine injuries.\nLeading that effort as Inquiry Counsel is Canadian attorney Shawn Buckley, one of Canada's foremost constitutional and regulatory lawyers and a longtime advocate for informed consent, civil liberties, and government accountability. Buckley has spent years examining Canada's response to the COVID-19 pandemic and has represented individuals challenging some of the government's most controversial public health policies.\nThe Allison Inquiry follows the independent National Citizens Inquiry, which conducted an extensive examination of Canada's broader COVID-19 response, hearing testimony on topics ranging from lockdowns and business closures to vaccine injury, censorship, and hospital protocols. By contrast, The Allison Inquiry has a much narrower mandate: to hear testimony relating specifically to Canadians who report injuries following COVID-19 vaccination and to place those experiences before Parliament.\nThis week on VSRF Live, Shawn Buckley joins us to explain what The Allison Inquiry is, what it hopes to accomplish, and how it differs from previous efforts to examine Canada's pandemic response. We'll discuss the inquiry's scope, goals, and limitations, what Canadians can expect from the proceedings, and why many believe this process could represent an important step toward greater recognition, transparency, and accountability for those who say they were harmed.\nWhether one views The Allison Inquiry as a beginning, a continuation, or another chapter in Canada's ongoing examination of the pandemic, one thing is certain: the experiences of Canadians reporting COVID-19 vaccine injuries are once again being entered into the public record. Show less", "thumbnail": "https://hugh.cdn.rumble.cloud/video/fww1/93/s8/1/C/7/m/P/C7mPA.qR4e-small-VSRF-Live-241-Canada-Reopen..jpg", "display_id": "v7byesw", "fulltitle": "VSRF Live #241 - Canada Reopens the Record on COVID Vaccine Injuries", "duration_string": "1:32:07", "upload_date": "20260813", "release_date": "20260818", "release_year": 2026, "is_live": false, "was_live": true, "epoch": 1794324449, "acodec": "aac", "vcodec": "none", "url": "https://hugh.cdn.rumble.cloud/video/fww1/93/s8/2/C/7/m/P/C7mPA.Gaa.rec.aac", "format_id": "audio-192p", "tbr": 192, "filesize": 132651886, "width": 0, "height": 192, "protocol": "https", "ext": "aac", "audio_ext": "aac", "video_ext": "none", "vbr": 0, "abr": 192, "resolution": "audio only", "aspect_ratio": 0.0, "http_headers": {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/148.0.0.0 Safari/537.36", "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8", "Accept-Language": "en-us,en;q=0.5", "Sec-Fetch-Mode": "navigate"}, "format": "audio-192p - audio only", "_type": "video", "_version": {"version": "2026.11.04.232659", "release_git_head": "412e7f0a4b0588fe884a02b344ac66a06538475b", "repository": "yt-dlp/yt-dlp-nightly-builds"}}