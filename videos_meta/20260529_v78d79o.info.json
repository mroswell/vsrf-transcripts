mat": "hls-2141-1 - 1280x720"}, {"format_id": "hls-4407", "url": "https://hugh.cdn.rumble.cloud/video/fwe2/ac/s8/2/u/S/o/s/uSosA.Eaa.rec.tar?r_file=chunklist.m3u8&r_type=application%2Fvnd.apple.mpegurl&r_range=3607698432-3607768068", "manifest_url": "https://rumble.com/hls-vod/7dkTOdIcBRI/playlist-721.m3u8", "tbr": 4407.0, "ext": "mp4", "protocol": "m3u8_native", "has_drm": false, "width": 1280, "height": 720, "video_ext": "mp4", "audio_ext": "none", "resolution": "1280x720", "dynamic_range": "SDR", "aspect_ratio": 1.78, "http_headers": {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/148.0.0.0 Safari/537.36", "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8", "Accept-Language": "en-us,en;q=0.5", "Sec-Fetch-Mode": "navigate"}, "format": "hls-4407 - 1280x720"}], "subtitles": {}, "thumbnails": [{"url": "https://hugh.cdn.rumble.cloud/video/fwe2/ac/s8/1/u/S/o/s/uSosA.aiEB-small-VSRF-Live-230-The-Cost-Of-C..jpg", "width": 720, "height": 1280, "id": "0", "resolution": "720x1280"}, {"url": "https://hugh.cdn.rumble.cloud/video/fwe2/ac/s8/1/u/S/o/s/uSosA.qR4e-small-VSRF-Live-230-The-Cost-Of-C..jpg", "width": 1280, "height": 720, "id": "1", "resolution": "1280x720"}], "timestamp": 1780072195, "channel": "Vaccine Safety Research Foundation", "channel_url": "https://rumble.com/c/VaccineSafetyResearchFoundation", "duration": 6548, "uploader": "Vaccine Safety Research Foundation", "live_status": "was_live", "webpage_url": "https://rumble.com/v7ajv9w-vsrf-live-230-the-cost-of-compliance.html", "webpage_url_basename": "v7ajv9w-vsrf-live-230-the-cost-of-compliance.html", "webpage_url_domain": "rumble.com", "extractor": "RumbleEmbed", "extractor_key": "RumbleEmbed", "release_timestamp": 1780441213, "view_count": 8588, "like_count": 121, "dislike_count": 0, "description": "SIGN THE PETITION👇 End the 40 year reign of terror. Restore accountability and legal liability to vaccine manufacturers. www.vacsafety.org/petitionShow more This week on VSRF Live, we speak with Canadian mother Kayla Pollock about the life-altering neurological injuries she suffered after receiving a COVID-19 booster shot.\nBefore 2022, Kayla was an active single mother, teaching assistant, and animal trainer. Like many Canadians during the pandemic, she faced mounting pressure surrounding vaccine mandates, including concerns about employment and being able to visit her father in long-term care.\nAfter receiving a Moderna booster, Kayla began developing severe neurological symptoms that rapidly progressed. She was later diagnosed with transverse myelitis, a rare inflammatory spinal cord condition, and today lives as an incomplete quadriplegic requiring a wheelchair and daily assistance.\nIn this conversation, Kayla describes the sudden collapse of the life she once knew: repeated hospitalizations, loss of mobility and independence, chronic pain, financial strain, and the emotional toll of navigating a medical system that failed to meaningfully acknowledge or investigate what happened to her.\nKayla has since filed a lawsuit against Moderna and become one of many Canadians navigating the country’s controversial Vaccine Injury Support Program (VISP), where injured individuals face delays, denials, and little transparency.\nBut what makes Kayla’s story so compelling is not simply the severity of her injury — it is the strength with which she continues to face it. Despite chronic pain, limited mobility, financial hardship, and overwhelming isolation, Kayla continues fighting every day for her independence, her voice, and her ability to remain present in her son’s life. Those closest to her describe her as deeply compassionate, resilient, and determined to help others facing similar struggles.\nThis is a conversation about informed consent, institutional trust, and what happens to ordinary people when the systems they trusted fail them in their time of greatest need. Show less", "thumbnail": "https://hugh.cdn.rumble.cloud/video/fwe2/ac/s8/1/u/S/o/s/uSosA.qR4e-small-VSRF-Live-230-The-Cost-Of-C..jpg", "display_id": "v78d79o", "fulltitle": "VSRF Live #230 - The Cost Of Compliance", "duration_string": "1:49:08", "upload_date": "20260529", "release_date": "20260602", "release_year": 2026, "is_live": false, "was_live": true, "epoch": 1794321854, "acodec": "aac", "vcodec": "none", "url": "https://hugh.cdn.rumble.cloud/video/fwe2/ac/s8/2/u/S/o/s/uSosA.Gaa.rec.aac", "format_id": "audio-192p", "tbr": 191, "filesize": 157169372, "width": 0, "height": 192, "protocol": "https", "ext": "aac", "audio_ext": "aac", "video_ext": "none", "vbr": 0, "abr": 191, "resolution": "audio only", "aspect_ratio": 0.0, "http_headers": {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/148.0.0.0 Safari/537.36", "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8", "Accept-Language": "en-us,en;q=0.5", "Sec-Fetch-Mode": "navigate"}, "format": "audio-192p - audio only", "_type": "video", "_version": {"version": "2026.11.04.232659", "release_git_head": "412e7f0a4b0588fe884a02b344ac66a06538475b", "repository": "yt-dlp/yt-dlp-nightly-builds"}}