1280x720"}], "timestamp": 1753199097, "channel": "Vaccine Safety Research Foundation", "channel_url": "https://rumble.com/c/VaccineSafetyResearchFoundation", "duration": 7015, "uploader": "Vaccine Safety Research Foundation", "live_status": "was_live", "webpage_url": "https://rumble.com/v6wj0ze-episode-187-science-vs.-spin-kirsch-and-lataster-set-the-record-straight.html", "webpage_url_basename": "v6wj0ze-episode-187-science-vs.-spin-kirsch-and-lataster-set-the-record-straight.html", "webpage_url_domain": "rumble.com", "extractor": "RumbleEmbed", "extractor_key": "RumbleEmbed", "release_timestamp": 1753398004, "view_count": 8694, "like_count": 130, "dislike_count": 1, "description": "This Thursday VSRF LIVE is back with a must-see conversation: Science vs. Spin -- Kirsch and Lataster Set the Record Straight.Show more Fresh off his trip to Australia, Steve sits down with Dr. Raphael Lataster, PhD — an Australian academic and philosopher — to dissect one of the most controversial studies in recent memory: the Watson et al. study (2022). https://www.thelancet.com/journals/laninf/article/PIIS1473-3099(22)00320-6/fulltext\nThis is the paper the media rushed to praise… but few bothered to read. It’s the paper most often cited to justify the Covid-19 “vaccines,” claiming they saved over 14 million lives in their first year alone. But how solid is the science behind that headline?\nDr. Lataster brings a fearless, scholarly lens to the conversation, and together, he and Steve will walk through what the Watson et al. study -- and similar studies -- really say, and don't say, about vaccine outcomes and mortality data. They’ll unpack the methodology, expose the manipulation, and deliver the facts the mainstream won’t touch.\nIf you're tired of propaganda posing as science, this episode will feel like a breath of fresh air.\nExpect data. Expect clarity. Expect the truth.\nBecause science deserves scrutiny. And we’re not done asking the hard questions.\n📺 Tune in Thursday at 7 PM ET / 4 PM PT\nStreaming live on Rumble and X (@VSRFofficial)\nBring your friends. Bring your questions.\nDonations are tax deductible and we need your support to continue our work into 2024. Or to text-to-donate, text VSRF to 53-555 Show less", "thumbnail": "https://1a-1791.com/video/fww1/3c/s8/1/6/o/y/4/6oy4y.qR4e.1-small-Episode-187-Science-vs.-Spi.jpg", "display_id": "v6uc4qk", "fulltitle": "Episode 187: Science vs. Spin, Kirsch and Lataster Set the Record Straight", "duration_string": "1:56:55", "upload_date": "20250722", "release_date": "20250724", "release_year": 2025, "is_live": false, "was_live": true, "epoch": 1777727574, "acodec": "aac", "vcodec": "none", "url": "https://1a-1791.com/video/fww1/3c/s8/2/6/o/y/4/6oy4y.Gaa.rec.aac", "format_id": "audio-192p", "tbr": 191, "filesize": 168359532, "width": 0, "height": 192, "protocol": "https", "ext": "aac", "audio_ext": "aac", "video_ext": "none", "vbr": 0, "abr": 191, "resolution": "audio only", "aspect_ratio": 0.0, "http_headers": {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/140.0.0.0 Safari/537.36", "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8", "Accept-Language": "en-us,en;q=0.5", "Sec-Fetch-Mode": "navigate"}, "format": "audio-192p - audio only", "_type": "video", "_version": {"version": "2026.01.31", "release_git_head": "9a9a6b6fe44a30458c1754ef064f354f04a84004", "repository": "yt-dlp/yt-dlp"}}