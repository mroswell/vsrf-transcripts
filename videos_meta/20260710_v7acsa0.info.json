bleEmbed", "release_timestamp": 1784070038, "view_count": 14903, "like_count": 185, "dislike_count": 3, "description": "SIGN THE PETITION👇 End the 40 year reign of terror. Restore accountability and legal liability to vaccine manufacturers. www.vacsafety.org/petitionShow more Artificial intelligence. Digital identity. Expanding surveillance. Global uncertainty. Recent congressional hearings on MKUltra and renewed calls to declassify decades-old intelligence records have once again raised questions about government transparency, public trust, and the forces that shape our world. Around the globe, many people sense that society is entering a period of profound change—but disagree about what's driving it and where it's leading.\nFor more than three decades, bestselling author David Icke has challenged conventional narratives surrounding power, technology, media, and the forces he believes are shaping modern society. Through more than twenty books—including The Biggest Secret and his newest, The Road Map: Escaping the Maze of Madness—he has become one of the world's most widely recognized independent voices examining the intersection of politics, technology, consciousness, and human freedom.\nThis week, Steve Kirsch sits down with David for a wide-ranging conversation about the forces reshaping our world and what they could mean for the future of freedom, human autonomy, and society itself.\nTogether, they'll discuss the recent MKUltra hearings, Rep. Anna Paulina Luna's call to declassify additional CIA records, and testimony surrounding Operation Paperclip and the recruitment of former Nazi scientists following World War II. They'll also explore artificial intelligence, digital identity, surveillance, censorship, and the growing concentration of political and institutional power. Finally, Steve and David will examine why David believes consciousness, perception, and our understanding of reality are essential to preserving human freedom, and how the ideas in The Road Map: Escaping the Maze of Madness relate to what he sees as one of the most consequential decades in modern history.\nWhether you've followed David's work for years or are hearing him for the first time, this promises to be a fascinating and thought-provoking conversation exploring some of the biggest questions facing humanity today.\nJoin us live Tuesday at 7:00 PM Eastern Show less", "thumbnail": "https://hugh.cdn.rumble.cloud/video/fww1/b8/s8/1/W/e/-/E/We-EA.qR4e-small-VSRF-Live-236-THE-ROAD-MAP-..jpg", "display_id": "v7acsa0", "fulltitle": "VSRF Live #236 - THE ROAD MAP: DAVID ICKE ON POWER, PERCEPTION, AND THE FUTURE", "duration_string": "2:31:30", "upload_date": "20260710", "release_date": "20260714", "release_year": 2026, "is_live": false, "was_live": true, "epoch": 1794322807, "acodec": "aac", "vcodec": "none", "url": "https://hugh.cdn.rumble.cloud/video/fww1/b8/s8/2/W/e/-/E/We-EA.Gaa.rec.aac", "format_id": "audio-192p", "tbr": 191, "filesize": 218162992, "width": 0, "height": 192, "protocol": "https", "ext": "aac", "audio_ext": "aac", "video_ext": "none", "vbr": 0, "abr": 191, "resolution": "audio only", "aspect_ratio": 0.0, "http_headers": {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/148.0.0.0 Safari/537.36", "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8", "Accept-Language": "en-us,en;q=0.5", "Sec-Fetch-Mode": "navigate"}, "format": "audio-192p - audio only", "_type": "video", "_version": {"version": "2026.11.04.232659", "release_git_head": "412e7f0a4b0588fe884a02b344ac66a06538475b", "repository": "yt-dlp/yt-dlp-nightly-builds"}}