igate"}, "format": "hls-2140-1 - 1280x720"}, {"format_id": "hls-5314", "url": "https://hugh.cdn.rumble.cloud/video/fww1/a9/s8/2/8/l/j/5/8lj5A.Eaa.rec.tar?r_file=chunklist.m3u8&r_type=application%2Fvnd.apple.mpegurl&r_range=3598350848-3598408453", "manifest_url": "https://rumble.com/hls-vod/oL70w-FtIsY/playlist-721.m3u8", "tbr": 5314.0, "ext": "mp4", "protocol": "m3u8_native", "has_drm": false, "width": 1280, "height": 720, "video_ext": "mp4", "audio_ext": "none", "resolution": "1280x720", "dynamic_range": "SDR", "aspect_ratio": 1.78, "http_headers": {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/148.0.0.0 Safari/537.36", "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8", "Accept-Language": "en-us,en;q=0.5", "Sec-Fetch-Mode": "navigate"}, "format": "hls-5314 - 1280x720"}], "subtitles": {"en-auto": [{"url": "https://hugh.cdn.rumble.cloud/video/fww1/a9/s8/11/8/l/j/5/8lj5A.fn8Si.vtt", "name": "English (auto)", "ext": "vtt"}]}, "thumbnails": [{"url": "https://hugh.cdn.rumble.cloud/video/fww1/a9/s8/1/8/l/j/5/8lj5A.aiEB-small-VSRF-Live-249-When-Protocal..jpg", "width": 720, "height": 1280, "id": "0", "resolution": "720x1280"}, {"url": "https://hugh.cdn.rumble.cloud/video/fww1/a9/s8/1/8/l/j/5/8lj5A.qR4e-small-VSRF-Live-249-When-Protocal..jpg", "width": 1280, "height": 720, "id": "1", "resolution": "1280x720"}], "timestamp": 1791562131, "channel": "Vaccine Safety Research Foundation", "channel_url": "https://rumble.com/c/VaccineSafetyResearchFoundation", "duration": 5416, "uploader": "Vaccine Safety Research Foundation", "live_status": "was_live", "webpage_url": "https://rumble.com/v7gmigs-vsrf-live-249-when-protocal-replaces-patient-care.html", "webpage_url_basename": "v7gmigs-vsrf-live-249-when-protocal-replaces-patient-care.html", "webpage_url_domain": "rumble.com", "extractor": "RumbleEmbed", "extractor_key": "RumbleEmbed", "release_timestamp": 1791932407, "view_count": 8792, "like_count": 143, "dislike_count": 0, "description": "What happens when hospital protocol takes precedence over the individual patient?Show more Dr. James Miller witnessed that transformation firsthand during COVID. A board-certified surgeon with extensive experience in trauma and surgical critical care, Miller was practicing at Providence Regional Medical Center Everett in Washington—the hospital that treated the first officially identified COVID-19 case in the United States.\nAs the pandemic unfolded, Miller says he watched individualized medical judgment and patient-centered care increasingly give way to rigid protocols. COVID patients were isolated from their families. Layers of PPE created barriers between critically ill patients and their caregivers. Patients were treated with drugs, heavy sedation and mechanical ventilation under protocols that Miller came to believe were causing harm.\nHe also witnessed something even more disturbing: a growing hostility toward the unvaccinated. Miller says unvaccinated patients were being denied care in his community and that, inside the hospital, vaccination status could result in a different standard of treatment.\nRather than stand by, Miller helped open a free clinic at his church, where he and a small team cared for more than 100 patients who were struggling to obtain treatment elsewhere. His willingness to challenge the prevailing COVID policies ultimately came with significant professional consequences.\nLast month, Miller brought his story to Washington, D.C., testifying at Senator Ron Johnson’s roundtable on COVID-19 hospital protocols about patient mistreatment, discrimination against the unvaccinated, and retaliation against doctors who challenged the system.\nThis week on VSRF Live, Dr. James Miller joins Steve Kirsch to reveal what he witnessed inside the hospital system during COVID—and what can happen when protocol replaces patient care. Show less", "thumbnail": "https://hugh.cdn.rumble.cloud/video/fww1/a9/s8/1/8/l/j/5/8lj5A.qR4e-small-VSRF-Live-249-When-Protocal..jpg", "display_id": "v7eg5ja", "fulltitle": "VSRF Live #249 - When Protocol Replaces Patient Care", "duration_string": "1:30:16", "upload_date": "20261009", "release_date": "20261013", "release_year": 2026, "is_live": false, "was_live": true, "epoch": 1794326425, "acodec": "aac", "vcodec": "none", "url": "https://hugh.cdn.rumble.cloud/video/fww1/a9/s8/2/8/l/j/5/8lj5A.Gaa.rec.aac", "format_id": "audio-192p", "tbr": 192, "filesize": 130006483, "width": 0, "height": 192, "protocol": "https", "ext": "aac", "audio_ext": "aac", "video_ext": "none", "vbr": 0, "abr": 192, "resolution": "audio only", "aspect_ratio": 0.0, "http_headers": {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/148.0.0.0 Safari/537.36", "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8", "Accept-Language": "en-us,en;q=0.5", "Sec-Fetch-Mode": "navigate"}, "format": "audio-192p - audio only", "_type": "video", "_version": {"version": "2026.11.04.232659", "release_git_head": "412e7f0a4b0588fe884a02b344ac66a06538475b", "repository": "yt-dlp/yt-dlp-nightly-builds"}}