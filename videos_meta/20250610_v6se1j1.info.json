: 1749571941, "channel": "Vaccine Safety Research Foundation", "channel_url": "https://rumble.com/c/VaccineSafetyResearchFoundation", "duration": 5199, "uploader": "Vaccine Safety Research Foundation", "live_status": "was_live", "webpage_url": "https://rumble.com/v6ukxrv-episode-181-a-doctors-crusade-to-stop-the-covid-shots.html", "webpage_url_basename": "v6ukxrv-episode-181-a-doctors-crusade-to-stop-the-covid-shots.html", "webpage_url_domain": "rumble.com", "extractor": "RumbleEmbed", "extractor_key": "RumbleEmbed", "release_timestamp": 1749769042, "view_count": 12764, "like_count": 202, "dislike_count": 2, "description": "We are honored to welcome back Dr. Mary Talley Bowden—physician, medical freedom advocate, and VSRF board member—for a powerful and timely conversation about her relentless crusade to put a stop to the Covid shots.Show more Dr. Bowden has become nationally recognized for her outspoken stance against the widespread use of COVID-19 mRNA vaccines and her commitment to defending patient autonomy. Her efforts to hold federal health agencies and pharmaceutical companies accountable have made her a leading voice in the fight for transparency and medical ethics.\nIn this episode, Dr. Bowden will discuss her personal and professional journey, including her legal battle with the Texas Medical Board and the recent commendation she received from the Texas State Legislature for her advocacy. She’ll also discuss the broader implications of government overreach, the erosion of informed consent, and what it will take to restore trust in medicine.\nWhether you are a concerned parent, medical professional, or simply seeking clarity in this confusing vaccine landscape , this interview promises critical insights and candid commentary from one of the most steadfast figures in the medical freedom movement.\nTune in Thursday at 7 PM ET / 4 PM PT on VSRF LIVE, streaming on Rumble and X.\nAs always, bring your questions and bring your friends!\nDonations are tax deductible and we need your support to continue our work into 2024. Or to text-to-donate, text VSRF to 53555 Show less", "thumbnail": "https://1a-1791.com/video/fww1/d1/s8/1/7/3/5/R/735Ry.qR4e-small-Episode-181-A-Doctors-Crusa.jpg", "display_id": "v6se1j1", "fulltitle": "Episode 181: A Doctor’s Crusade To Stop The Covid Shots", "duration_string": "1:26:39", "upload_date": "20250610", "release_date": "20250612", "release_year": 2025, "is_live": false, "was_live": true, "epoch": 1777727328, "acodec": "aac", "vcodec": "none", "url": "https://1a-1791.com/video/fww1/d1/s8/2/7/3/5/R/735Ry.Gaa.rec.aac", "format_id": "audio-192p", "tbr": 191, "filesize": 124773077, "width": 0, "height": 192, "protocol": "https", "ext": "aac", "audio_ext": "aac", "video_ext": "none", "vbr": 0, "abr": 191, "resolution": "audio only", "aspect_ratio": 0.0, "http_headers": {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/140.0.0.0 Safari/537.36", "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8", "Accept-Language": "en-us,en;q=0.5", "Sec-Fetch-Mode": "navigate"}, "format": "audio-192p - audio only", "_type": "video", "_version": {"version": "2026.01.31", "release_git_head": "9a9a6b6fe44a30458c1754ef064f354f04a84004", "repository": "yt-dlp/yt-dlp"}}