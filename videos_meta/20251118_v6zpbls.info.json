l": "Vaccine Safety Research Foundation", "channel_url": "https://rumble.com/c/VaccineSafetyResearchFoundation", "duration": 7298, "uploader": "Vaccine Safety Research Foundation", "live_status": "was_live", "webpage_url": "https://rumble.com/v71vzm0-episode-204-the-cult-of-vaccines.html", "webpage_url_basename": "v71vzm0-episode-204-the-cult-of-vaccines.html", "webpage_url_domain": "rumble.com", "extractor": "RumbleEmbed", "extractor_key": "RumbleEmbed", "release_timestamp": 1763683233, "view_count": 12270, "like_count": 251, "dislike_count": 2, "description": "Donations are tax deductible and we need your support to continue our work. Text-to-donate, text VSRF to 53-555.Show more This Thursday, we are honored to welcome the nation’s leading vaccine injury attorney, Aaron Siri, Esq., for an extraordinary conversation about his groundbreaking new book, Vaccines, Amen: The Religion of Vaccines.\nAs Siri points out, you never hear someone say, “I believe in cars.” Or, “I believe in tools.” But people often say, “I believe in vaccines.” That's because much of what we’ve been told about vaccines requires faith, not facts.\nIn Vaccines, Amen, Aaron Siri pulls back the curtain on decades of vaccine policy, science, and litigation. From the landmark National Childhood Vaccine Injury Act of 1986 to today’s post-COVID landscape, Siri exposes the contradictions between what health authorities claim publicly about vaccine science data and what they admit quietly under oath.\nAs the founder and Managing Partner of Siri & Glimstad LLP, and lead attorney for the Informed Consent Action Network (ICAN), Siri leverages over a decade of expertise, deposing top vaccinologists and litigating over 100 cases against health agencies, to present the evidence that dismantles common vaccine dogma.\nOn VSRF Live, Aaron will take us behind the scenes of his legal and scientific battles, including:\n*His infamous deposition of Dr. Stanley Plotkin, the “Godfather of Vaccines”\n*His recent U.S. Senate testimony, which made national headlines\n*The current and future landscape of vaccine injury legal cases, the prospects for ending the liability shields under the 1986 Act and the PREP Act, and what meaningful legal change might look like\nWhether you’ve followed Aaron Siri’s work for years or you’re just learning about his remarkable efforts for truth and transparency, this conversation is a must-watch. Show less", "thumbnail": "https://1a-1791.com/video/fww1/cb/s8/1/i/m/U/A/imUAz.qR4e-small-Episode-204-The-Cult-of-Vac.jpg", "display_id": "v6zpbls", "fulltitle": "Episode 204: The Cult of Vaccines", "duration_string": "2:01:38", "upload_date": "20251118", "release_date": "20251121", "release_year": 2025, "is_live": false, "was_live": true, "epoch": 1777728316, "acodec": "aac", "vcodec": "none", "url": "https://1a-1791.com/video/fww1/cb/s8/2/i/m/U/A/imUAz.Gaa.rec.aac", "format_id": "audio-192p", "tbr": 191, "filesize": 175149419, "width": 0, "height": 192, "protocol": "https", "ext": "aac", "audio_ext": "aac", "video_ext": "none", "vbr": 0, "abr": 191, "resolution": "audio only", "aspect_ratio": 0.0, "http_headers": {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/140.0.0.0 Safari/537.36", "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8", "Accept-Language": "en-us,en;q=0.5", "Sec-Fetch-Mode": "navigate"}, "format": "audio-192p - audio only", "_type": "video", "_version": {"version": "2026.01.31", "release_git_head": "9a9a6b6fe44a30458c1754ef064f354f04a84004", "repository": "yt-dlp/yt-dlp"}}